-- Shared Virtuoso libraries tracked in Git.
-- Each project's cds.lib includes this file (SOFTINCLUDE), so every library
-- listed here appears in Library Manager. Paths are relative to this file.
-- Add one line per library you put under analog/libs:
--   DEFINE <LibName> libs/<LibName>
DEFINE Forge_Analog libs/Forge_Analog
DEFINE Luca_BGR libs/Luca_BGR
DEFINE Abood_SampleAndHold libs/Abood_SampleAndHold
DEFINE Forge_SAR_ADC libs/Forge_SAR_ADC
